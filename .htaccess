# ============================================================
#  Pabloch Tech — Apache / LiteSpeed config for Hostinger
#
#  NO HTTPS REDIRECT IN HERE, ON PURPOSE.
#  Use hPanel → Security → SSL → "Force HTTPS" instead.
#
#  Why: on shared hosting that terminates SSL at a proxy, the
#  origin never sees %{HTTPS} == on, so a redirect rule based on
#  it fires on every request forever — ERR_TOO_MANY_REDIRECTS.
#  hPanel's toggle runs above that layer and knows the truth.
#  Everything below is safe: no redirects, nothing that can loop.
# ============================================================

Options -Indexes
DirectoryIndex index.html
ErrorDocument 404 /404.html

# ---- modern file types ---------------------------------------
<IfModule mod_mime.c>
  AddType font/woff2  .woff2
  AddType image/avif  .avif
  AddType image/webp  .webp
  AddType image/svg+xml .svg
</IfModule>

# ---- never serve the source, tooling or notes ------------------
# The site is built from src/ by `npm run build`; only the output is public.
RedirectMatch 404 ^/(src|scripts|node_modules)(/|$)
<FilesMatch "^(package\.json|package-lock\.json|tsconfig\.json|README\.md)$">
  Require all denied
</FilesMatch>

# ---- compression -------------------------------------------
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/plain text/xml
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# ---- caching -----------------------------------------------
# index.html must never be stale or an update won't show.
# Images never change without changing filename, so a year is safe.
# config.js is never cached without checking (see below): it holds the
# handles and form key, and an old copy must never outlive a change.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault                       "access plus 1 week"
  ExpiresByType text/html              "access plus 0 seconds"
  ExpiresByType application/javascript "access plus 1 day"
  ExpiresByType text/javascript        "access plus 1 day"
  ExpiresByType text/css               "access plus 1 year"
  ExpiresByType image/jpeg             "access plus 1 year"
  ExpiresByType image/png              "access plus 1 year"
  ExpiresByType image/svg+xml          "access plus 1 year"
  ExpiresByType image/x-icon           "access plus 1 year"
  ExpiresByType image/webp             "access plus 1 year"
  ExpiresByType image/avif             "access plus 1 year"
  ExpiresByType font/woff2             "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>

  # Built bundles carry a content hash in their name (app.1a2b3c.js), so they
  # can be cached forever — a new build is a new filename.
  <FilesMatch "^app\.[a-f0-9]+\.(css|js)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # config.js: browsers must re-check it on every visit (a tiny request that
  # normally comes back "304 not modified"), so a changed handle, email or
  # form key shows up immediately. The page also loads it as config.js?v=…
  # with a fingerprint, which bypasses any copy cached under the old rules.
  <FilesMatch "^config\.js$">
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
  </FilesMatch>

  # ---- security headers ------------------------------------
  # The Content-Security-Policy lives in a <meta> tag in index.html, written
  # by the build with the hash of the one tiny inline script. Keeping it in
  # the page (not here) means it can never drift out of sync with the build.
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), interest-cohort=()"
</IfModule>

# ---- Google Search Console ownership proof -------------------
# /googleeaf0a72808bb7594.html must stay publicly reachable, unchanged, at the
# site root. Never add a rule that blocks, redirects or rewrites it.

# ---- never serve these -------------------------------------
<FilesMatch "^\.(git|env|gitignore|htaccess)">
  Require all denied
</FilesMatch>

# ============================================================
#  If you ever move to a host where %{HTTPS} is reliable and you
#  want the redirect back, this version is loop-safe because it
#  also checks the proxy header:
#
#  <IfModule mod_rewrite.c>
#    RewriteEngine On
#    RewriteCond %{HTTPS} !=on
#    RewriteCond %{HTTP:X-Forwarded-Proto} !=https
#    RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
#  </IfModule>
#
#  The www → bare-domain redirect is deliberately gone too: the
#  SSL certificate currently covers pablochtech.com only, so
#  anyone reaching https://www. hits a certificate warning BEFORE
#  any redirect can run. Add www to the certificate in hPanel
#  first, then re-add the redirect if you want it.
# ============================================================
